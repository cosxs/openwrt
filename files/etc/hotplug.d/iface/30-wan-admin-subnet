#!/bin/sh

# Keep the wan_admin_subnet set at the WAN's own IPv4 subnet while that subnet
# is private, so only devices of the upstream home network reach SSH and the
# web interface. A public, point-to-point or missing WAN address empties it.
[ "$INTERFACE" = wan ] || exit 0
case "$ACTION" in
    ifup|ifupdate|ifdown) ;;
    *) exit 0 ;;
esac

subnet=''
cidr=''
if [ "$ACTION" != ifdown ]; then
    . /lib/functions/network.sh
    if network_get_subnet cidr wan; then
        eval "$(/bin/ipcalc.sh "$cidr")"
        if [ "$PREFIX" -ge 8 ] && [ "$PREFIX" -le 30 ]; then
            case "$NETWORK" in
                10.*)
                    subnet=$NETWORK/$PREFIX ;;
                172.1[6-9].*|172.2[0-9].*|172.3[01].*)
                    [ "$PREFIX" -ge 12 ] && subnet=$NETWORK/$PREFIX ;;
                192.168.*)
                    [ "$PREFIX" -ge 16 ] && subnet=$NETWORK/$PREFIX ;;
            esac
        fi
    fi
fi

file=/etc/wan-admin-subnet
new=$(printf '# WAN IPv4 subnet allowed by the wan_private_admin firewall rule\n%s\n' "$subnet")
[ "$new" = "$(cat "$file" 2> /dev/null)" ] && exit 0
printf '%s\n' "$new" > "$file"
fw4 -q reload-sets
