#!/bin/sh

# Factory port layout for the physical ethN ports present during board
# detection, plugged in or not: a single eth0 joins the LAN as a DHCP client;
# with more ports, eth0 is the WAN and the others form the LAN. Like upstream
# 99-default_network, this leaves boards alone that 02_network already
# describes, and boards without a physical eth0.
. /lib/functions/uci-defaults.sh

board_config_update
json_is_a network object && exit 0

ports=''
for n in $(ls /sys/class/net | sed -n 's/^eth\([0-9][0-9]*\)$/\1/p' | sort -n); do
    [ -e "/sys/class/net/eth$n/device" ] || continue
    [ "$(cat "/sys/class/net/eth$n/type" 2> /dev/null)" = 1 ] || continue
    ports="$ports eth$n"
done
# shellcheck disable=SC2086 # split the port list into arguments
set -- $ports
[ "$1" = eth0 ] || exit 0

if [ $# = 1 ]; then
    ucidef_set_interface_lan eth0 dhcp
else
    shift
    ucidef_set_interface lan device "$*" protocol static ipaddr 192.168.72.1
    ucidef_set_interface_wan eth0
fi
board_config_flush
