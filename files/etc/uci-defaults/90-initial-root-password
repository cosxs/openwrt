#!/bin/sh

# Initial root password for first boot and factory reset (SHA-512 crypt).
# A password restored from kept settings, including an account lock, is left
# unchanged. Only the empty root password field is replaced.
initial_root_hash='$6$GF3FQ4VlxowuflrN$ALTFiOPrT9MKo/7eIHsKtQQscHjyZ/Jl2SDoaOJS3e4wpeRc.oWpwvtkDsxmTqz/D0ozzyyzc0KFezkyiMgTo.'

grep -q '^root::' /etc/shadow || exit 0
sed -i "s|^root::|root:$initial_root_hash:|" /etc/shadow
